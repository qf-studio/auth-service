# Auth Service — Staging Environment
# Copy to .env.staging and fill in real values

# ── Server ──────────────────────────────────────────
APP_ENV=staging
PUBLIC_PORT=4000
ADMIN_PORT=4001
LOG_LEVEL=debug

# ── PostgreSQL ──────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=auth_staging
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=CHANGE_ME_staging_db_password
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10

# ── Redis ───────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_staging_redis_password
REDIS_DB=0

# ── JWT / Token Signing ─────────────────────────────
# Path to ES256 or EdDSA private key (PEM)
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_ALGORITHM=ES256
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=24h
# Comma-separated `aud` values for issued access tokens. Leave empty/unset to
# disable — no aud claim is added and audience validation stays off. Clients
# can override this per-application via the admin client API's `audience`
# field.
JWT_AUDIENCE=

# Reject tokens whose `aud` doesn't match JWT_AUDIENCE. Default false to avoid
# a rotation hazard when JWT_AUDIENCE is first configured.
JWT_AUDIENCE_ENFORCE=false

# ── System Secrets ──────────────────────────────────
# Comma-separated; newest first for rotation
SYSTEM_SECRETS=CHANGE_ME_staging_system_secret_1

# ── Password Hashing (Argon2id) ────────────────────
ARGON2_MEMORY=19456
ARGON2_TIME=2
ARGON2_PARALLELISM=1
PASSWORD_PEPPER=CHANGE_ME_staging_pepper

# ── Rate Limiting ───────────────────────────────────
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# ── Trusted Proxies ──────────────────────────────────
# CIDRs trusted to set X-Forwarded-Proto/X-Forwarded-Host, used to
# reconstruct the externally-visible scheme for DPoP htu validation. Empty
# (default) trusts nothing. This stack has no TLS termination in front of it
# today, so leave unset; set to the VPC CIDR(s) if that changes (see
# production example / deployments/README.md, GH-508).
TRUSTED_PROXY_CIDRS=

# ── CORS ────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://staging.quantflow.studio
